<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DAC4GIL.Application\DAC4GIL.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DAC4GIL.Infra.CrossCutting\DAC4GIL.Infra.CrossCutting.csproj" />
  </ItemGroup>
  <!-- The API references Messaging DTOs, but must publish its own configuration. -->
  <Target Name="ExcludeWorkerSettingsFromApiPublish" AfterTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <WorkerSettingsPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../DAC4GIL.Messaging/appsettings.json'))</WorkerSettingsPath>
      <WorkerDevelopmentSettingsPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../DAC4GIL.Messaging/appsettings.Development.json'))</WorkerDevelopmentSettingsPath>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.FullPath)' == '$(WorkerSettingsPath)' Or '%(ResolvedFileToPublish.FullPath)' == '$(WorkerDevelopmentSettingsPath)'" />
    </ItemGroup>
  </Target>
</Project>
